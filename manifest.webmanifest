{
  "name": "Modellblick – 3D-Modell-Viewer",
  "short_name": "Modellblick",
  "description": "STL, 3MF, OBJ und PLY ansehen, drehen, einfärben und vor dem 3D-Druck prüfen – mit Druckzeit-Schätzung.",
  "lang": "de",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "orientation": "any",
  "background_color": "#14171c",
  "theme_color": "#14171c",
  "categories": ["utilities", "productivity"],
  "icons": [
    { "src": "icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "file_handlers": [
    {
      "action": "./",
      "accept": {
        "model/stl": [".stl"],
        "model/3mf": [".3mf"],
        "model/obj": [".obj"],
        "application/ply": [".ply"]
      }
    }
  ]
}
